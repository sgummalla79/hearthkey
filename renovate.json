{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", "helpers:pinGitHubActionDigests"],
  "labels": ["dependencies"],
  "timezone": "America/Los_Angeles",
  "schedule": ["before 9am on monday"],
  "prConcurrentLimit": 3,
  "packageRules": [
    { "matchUpdateTypes": ["minor", "patch"], "groupName": "non-major dependencies" },
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["docker/**"],
      "groupName": "docker actions"
    },
    { "matchPackageNames": ["typescript"], "allowedVersions": "<7" },
    { "matchPackageNames": ["pnpm"], "allowedVersions": "<12" }
  ]
}
