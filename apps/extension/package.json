{
  "name": "@hearthkey/extension",
  "version": "0.1.0",
  "private": true,
  "description": "Hearthkey Chrome extension (Manifest V3)",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "wxt prepare && tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@wxt-dev/module-react": "^1.2.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "wxt": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
